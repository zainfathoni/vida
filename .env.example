# Copy this file to .env and fill in what you use. .env is not committed.
# The browser never receives these values.

# Local transcription with whisper.cpp (recommended: offline, free).
# macOS: brew install whisper-cpp   (installs whisper-cli)
# WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_CPP_MODEL=/Users/you/models/ggml-base.en.bin
# WHISPER_LANGUAGE=auto

# OpenAI-compatible transcription API (optional; uploads audio).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Other settings
# PORT=5178
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
